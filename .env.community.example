# Aularo — Community Edition environment template
# Formerly Clarra.
# =================================================
# Self-hosted, AGPLv3. Every feature is unlocked and there are no plan limits —
# you run on your own infrastructure. There is NO Stripe / billing config here;
# billing is a cloud-only concern.
#
# Copy to .env.local and fill in. Generate secrets with the commands noted.

# ── Edition ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_EDITION=community

# Data driver. Today the community edition runs on Firebase (the "Phase 4"
# preview). A Postgres/Supabase driver is planned (docs/open-core.md, Phase 5)
# for a fully self-hostable, Google-free deployment.
DATA_DRIVER=firestore

# ── Firebase — client (public, safe to ship in the bundle) ──────────────────
# Create a free Firebase project: Auth (Email/Password + Google) and Firestore.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase — Admin SDK (server-only) ──────────────────────────────────────
# Paste the entire service-account JSON as a single-line string.
FIREBASE_SERVICE_ACCOUNT=

# Session cookie secret (random 32+ byte string). Generate:
#   openssl rand -base64 48
FIREBASE_SESSION_SECRET=

# ── Object storage (any S3-compatible: Cloudflare R2, MinIO, AWS S3) ─────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ── Public URLs (OAuth callbacks, links) ────────────────────────────────────
# Production:
#   NEXT_PUBLIC_APP_URL=https://aularo.com
#   NEXT_PUBLIC_SCREEN_URL=https://screen.aularo.com
#   NEXT_PUBLIC_DASHBOARD_URL=https://screen.aularo.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SCREEN_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000

# ── Optional: Google Drive / Dropbox media sync ─────────────────────────────
# Bring your own OAuth apps. Leave unset to disable these integrations.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/drive/callback
# Production: https://screen.aularo.com/api/auth/drive/callback
# DROPBOX_CLIENT_ID=
# DROPBOX_CLIENT_SECRET=
# DROPBOX_REDIRECT_URI=http://localhost:3000/api/auth/dropbox/callback
# Production: https://screen.aularo.com/api/auth/dropbox/callback

# Envelope key for encrypting stored OAuth tokens (required only if you enable
# Drive/Dropbox). Generate: openssl rand -base64 32
# TOKEN_ENCRYPTION_KEY=

# ── Optional: scheduled jobs ────────────────────────────────────────────────
# Secret to authenticate calls to /api/cron/* if you wire up a scheduler.
# Generate: openssl rand -hex 32
# CRON_SECRET=

# ── Optional: dev seeder (non-prod only) ────────────────────────────────────
# SEED_TOKEN=
