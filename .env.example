# ── Edition ───────────────────────────────────────────────────────────────
# "cloud" = managed multi-tenant build (Stripe billing + plan tiers active).
# "community" = self-hosted AGPL build (all features unlocked, no billing).
# Compiled into the bundle at build time. This file is the CLOUD template;
# see .env.community.example for a community-edition starting point.
NEXT_PUBLIC_EDITION=cloud

# Data driver. "firestore" today; "postgres" is the planned community default
# (see docs/open-core.md, Phase 5).
DATA_DRIVER=firestore

# Firebase — client (public, safe to ship in the bundle)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase — Admin SDK (server-only, never send to the client).
# Paste the entire JSON service-account contents as a single-line string.
FIREBASE_SERVICE_ACCOUNT=

# Session cookie secret (random 32+ byte string). Used to sign Firebase session cookies.
FIREBASE_SESSION_SECRET=

# Cloudflare R2 — media storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_VENUE=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Public URLs
# Production:
#   NEXT_PUBLIC_APP_URL=https://aularo.com
#   NEXT_PUBLIC_SCREEN_URL=https://screen.aularo.com
#   NEXT_PUBLIC_DASHBOARD_URL=https://screen.aularo.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SCREEN_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000

# Google Drive OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/drive/callback
# Production: https://screen.aularo.com/api/auth/drive/callback

# Dropbox OAuth
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_REDIRECT_URI=http://localhost:3000/api/auth/dropbox/callback
# Production: https://screen.aularo.com/api/auth/dropbox/callback

# Envelope key for OAuth refresh/access tokens stored in Firestore.
# Provide either a base64-encoded 32-byte key (recommended) or a passphrase
# of 32+ characters. Generate: `openssl rand -base64 32`.
# ROTATION: changing this invalidates stored tokens — users must reconnect
# Drive/Dropbox. Plan migrations accordingly.
TOKEN_ENCRYPTION_KEY=

# Development seeder — set only in non-prod environments where you want the
# /api/dev/seed endpoint active. Any sufficiently random string. In production
# the endpoint returns 404 regardless.
SEED_TOKEN=

# Optional: allow x-forwarded-for outside Vercel for rate-limit keying.
# Only set if you deploy behind a trusted proxy that overwrites XFF.
# TRUST_FORWARDED_FOR=1

# Secret used to authenticate Vercel Cron invocations of /api/cron/*.
# Vercel automatically sets this on its cron runner when configured in
# Vercel Dashboard → Project → Settings → Environment Variables.
# Generate: `openssl rand -hex 32`.
CRON_SECRET=
